# Copy this file to .env and fill in real values.
# .env is gitignored (see .gitignore). Never commit real secrets.
#
# Generate 32-byte base64 keys with:
#   openssl rand -base64 32

# SQL Server SA password (must satisfy SQL Server's complexity policy: 8+ chars,
# upper + lower + digit + symbol). Used by both the mssql container and the API.
MSSQL_SA_PASSWORD=Change.Me!Local#2026

# Application secrets (base64-encoded keys / salts).
ENCRYPTION_DATA_KEY_BASE64=replace-with-openssl-rand-base64-32
SHORTLINK_IP_SALT_BASE64=replace-with-openssl-rand-base64-32
JWT_SIGNING_KEY_BASE64=replace-with-openssl-rand-base64-32

# App-wide password pepper — combined with each user's salt in the cache.
USERCACHE_PASSWORD_SALT=replace-with-long-random-string

# Upstream AuthenAPI (leave blank if not yet wired — login will still work via cache).
AUTHEN_API_BASEURL=
AUTHEN_API_KEY=

# SMS providers — leave the one you're not using blank.
ETRACKER_USERNAME=
ETRACKER_PASSWORD=
INFOBIP_BASEURL=
INFOBIP_APIKEY=
