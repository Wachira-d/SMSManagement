<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config. The <aspNetCore> element below is a placeholder —
  `dotnet publish` rewrites processPath/arguments/hostingModel for the
  published output. The rewrite rule is preserved as-is.

  REQUIRES the IIS "URL Rewrite" module on the server; without it IIS
  returns HTTP 500.19 for the <rewrite> section.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!--
            Redirect every plain-HTTP request to HTTPS. Uses 302 (temporary)
            so a misconfiguration isn't cached by browsers; switch
            redirectType to "Permanent" (301) once HTTPS is verified stable.
          -->
          <rule name="HTTP to HTTPS redirect" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                    redirectType="Found" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SMSManagement.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <!--
          The app refuses to start unless these are set (StartupSecretsCheck).
          On the SERVER's deployed web.config, uncomment and fill the block
          below — or supply the values via system / app-pool environment
          variables, or a secrets manager. NEVER commit real values here.

          Generate the three Base64 keys (32 random bytes each) with:
            [Convert]::ToBase64String(
              [System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))

          Pick each value ONCE and keep it stable: rotating
          Encryption__DataKeyBase64 makes all existing ciphertext
          undecryptable; rotating the others invalidates cached password
          hashes / issued tokens.

        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ConnectionStrings__Default" value="" />
          <environmentVariable name="UserCacheAuth__PasswordSalt" value="" />
          <environmentVariable name="Encryption__DataKeyBase64" value="" />
          <environmentVariable name="Shortlink__IpHashSaltBase64" value="" />
          <environmentVariable name="Auth__LocalJwt__SigningKeyBase64" value="" />
        </environmentVariables>
        -->
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
