<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config. The <aspNetCore> element below is a placeholder —
  `dotnet publish` rewrites processPath/arguments/hostingModel for the
  published output. The rewrite rule is preserved as-is.

  REQUIRES the IIS "URL Rewrite" module on the server; without it IIS
  returns HTTP 500.19 for the <rewrite> section.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!--
            Redirect every plain-HTTP request to HTTPS. Uses 302 (temporary)
            so a misconfiguration isn't cached by browsers; switch
            redirectType to "Permanent" (301) once HTTPS is verified stable.
          -->
          <rule name="HTTP to HTTPS redirect" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                    redirectType="Found" />
          </rule>
        </rules>
      </rewrite>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SMSManagement.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
    </system.webServer>
  </location>
</configuration>
