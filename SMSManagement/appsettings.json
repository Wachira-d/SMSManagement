{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning" }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=__from_env__;Database=campaign;Username=__from_env__;Password=__from_env__"
  },
  "Auth": {
    "Authority": "https://__from_env__/.well-known/openid-configuration",
    "Audience":  "campaign-api"
  },
  "Encryption": {
    "_comment": "DataKeyBase64 must be injected at runtime via Key Vault / env var, NEVER committed.",
    "DataKeyBase64": ""
  },
  "Shortlink": {
    "_comment": "IpHashSaltBase64 injected from KMS at runtime.",
    "IpHashSaltBase64": "",
    "SlugLength": 8
  },
  "Sms": {
    "Providers": {
      "Etracker": {
        "BaseUrl": "https://www.etracker.cc/bulksms/mesapi.aspx",
        "_comment": "Username/Password resolved from Key Vault — appsettings must remain blank.",
        "Username": "",
        "Password": "",
        "DefaultSenderId": "Honda",
        "DefaultType": "0"
      }
    }
  },
  "AllowedHosts": "*"
}
