@page
@model SMSManagement.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "บริการส่งข้อความ SMS";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background:#f5f7fa; }
        .hero { background:linear-gradient(135deg,#1e3a8a,#2563eb); color:#fff; }
        .policy-card { height:100%; }
    </style>
</head>
<body>
<div class="hero py-5">
    <div class="container">
        <h1 class="fw-bold mb-2"><i class="bi bi-chat-dots-fill me-2"></i>บริการแจ้งข้อมูลทาง SMS</h1>
        <p class="lead mb-0">
            ระบบนี้ใช้สำหรับส่งข้อความแจ้งเตือนและคำเชิญร่วมทำแบบสำรวจให้กับลูกค้า
            ในนามขององค์กรที่เป็นเจ้าของแคมเปญ
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i>
        หากท่านได้รับ SMS จากเรา แล้วต้องการข้อมูลเพิ่มเติม โปรดอ่านนโยบายด้านล่าง
        หรือทำตามคำแนะนำในข้อความที่ได้รับ
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-6 col-lg-3">
            <div class="card policy-card shadow-sm">
                <div class="card-body">
                    <h5><i class="bi bi-hand-thumbs-down text-primary me-1"></i>การยกเลิกรับข้อความ</h5>
                    <p class="small mb-0">
                        หากไม่ประสงค์รับข้อความอีก พิมพ์ <strong>STOP</strong>
                        แล้วส่งกลับไปยังหมายเลขที่ระบุไว้ในข้อความ
                        ระบบจะหยุดส่งให้ท่านทันที
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card policy-card shadow-sm">
                <div class="card-body">
                    <h5><i class="bi bi-question-circle text-primary me-1"></i>ขอข้อมูลเพิ่มเติม</h5>
                    <p class="small mb-0">
                        พิมพ์ <strong>HELP</strong> ส่งกลับไปยังหมายเลขที่ระบุในข้อความ
                        เพื่อรับรายละเอียดเกี่ยวกับผู้ส่งและแคมเปญ
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card policy-card shadow-sm">
                <div class="card-body">
                    <h5><i class="bi bi-shield-lock text-primary me-1"></i>ความเป็นส่วนตัว</h5>
                    <p class="small mb-0">
                        หมายเลขโทรศัพท์และข้อมูลส่วนบุคคลถูกจัดเก็บแบบเข้ารหัส
                        ใช้เพื่อส่งข้อความของแคมเปญที่ท่านเกี่ยวข้องเท่านั้น
                        และไม่ถูกเผยแพร่ต่อบุคคลภายนอก
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card policy-card shadow-sm">
                <div class="card-body">
                    <h5><i class="bi bi-link-45deg text-primary me-1"></i>ลิงก์ในข้อความ</h5>
                    <p class="small mb-0">
                        ลิงก์แบบย่อในข้อความ (เช่น โดเมนนี้ตามด้วยรหัส) เป็นลิงก์ที่ระบบสร้างขึ้น
                        และจะนำท่านไปยังหน้าปลายทางของแคมเปญโดยตรง
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="mb-3"><i class="bi bi-file-text me-1"></i>นโยบายการให้บริการ</h5>
            <ul class="small mb-0">
                <li>ระบบส่งข้อความเฉพาะให้กับผู้ที่อยู่ในรายชื่อของแคมเปญที่องค์กรเจ้าของข้อมูลจัดเตรียมไว้</li>
                <li>เนื้อหาข้อความและผู้ส่ง (Sender ID) เป็นความรับผิดชอบขององค์กรเจ้าของแคมเปญ</li>
                <li>ท่านสามารถยกเลิกการรับข้อความได้ทุกเมื่อด้วยการพิมพ์ STOP</li>
                <li>ข้อมูลการคลิกลิงก์ถูกบันทึกแบบไม่ระบุตัวตนเพื่อวัดผลแคมเปญเท่านั้น</li>
                <li>หากพบการใช้งานในทางที่ผิด โปรดติดต่อองค์กรเจ้าของแคมเปญที่ระบุไว้ในข้อความ</li>
            </ul>
        </div>
    </div>

    <div class="text-center text-muted small mt-5">
        <a href="/campaign" class="text-decoration-none">
            <i class="bi bi-box-arrow-in-right me-1"></i>เข้าสู่ระบบสำหรับเจ้าหน้าที่
        </a>
    </div>
</div>
</body>
</html>
