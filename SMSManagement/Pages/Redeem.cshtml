@page "/redeem/{projectCode}/{token}"
@model SMSManagement.Pages.RedeemModel
@using SMSManagement.Modules.Coupon.Domain
@using SMSManagement.Modules.Coupon.Services
@{
    Layout = null;
    var c = Model.Coupon;
    var theme = c?.BrandThemeColor ?? "#0066cc";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>@(c?.BrandDisplayName ?? "Coupon")</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background:#f4f5f7; }
        .coupon-card { max-width: 440px; margin: 2rem auto; }
        .brand-bar { height: 6px; border-radius: 6px 6px 0 0; }
        .barcode-box svg { max-width: 100%; height: auto; }
    </style>
</head>
<body>
<div class="coupon-card card shadow-sm">
    <div class="brand-bar" style="background:@theme"></div>
    <div class="card-body text-center p-4">

    @if (Model.Blocked)
    {
        <h1 class="h5 text-danger">การเข้าถึงถูกระงับชั่วคราว</h1>
        <p class="text-muted small">มีการพยายามเข้าถึงผิดพลาดมากเกินไป กรุณาลองใหม่ภายหลัง</p>
    }
    else if (c is null)
    {
        <i class="bi"></i>
        <h1 class="h5">ไม่พบคูปอง</h1>
        <p class="text-muted small">ลิงก์อาจไม่ถูกต้องหรือหมดอายุแล้ว</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(c.BrandLogoUrl))
        {
            <img src="@c.BrandLogoUrl" alt="@c.BrandDisplayName" style="max-height:64px" class="mb-2" />
        }
        <h1 class="h5 mb-1">@c.BrandDisplayName</h1>
        <div class="display-6 fw-bold" style="color:@theme">
            ฿@c.Value.ToString("N0")
        </div>

        @if (Model.Outcome == RedeemResult.Redeemed || Model.Outcome == RedeemResult.AlreadyRedeemed
             || c.Status == CouponStatus.Redeemed)
        {
            <div class="alert @(Model.Outcome == RedeemResult.Redeemed ? "alert-success" : "alert-info") mt-3 mb-2">
                @(Model.Outcome == RedeemResult.Redeemed ? "ใช้คูปองสำเร็จ" : "คูปองนี้ถูกใช้ไปแล้ว")
            </div>
            @if (Model.BarcodeSvg is not null)
            {
                <div class="barcode-box my-3">@Html.Raw(Model.BarcodeSvg)</div>
            }
            @if (c.RealCode is not null)
            {
                <p class="font-monospace fs-5 mb-1">@c.RealCode</p>
            }
            <p class="text-muted small">แสดงบาร์โค้ดนี้ที่จุดชำระเงิน</p>
        }
        else if (Model.Outcome == RedeemResult.Expired || c.Status == CouponStatus.Expired)
        {
            <div class="alert alert-warning mt-3">คูปองหมดอายุแล้ว</div>
        }
        else if (Model.Outcome == RedeemResult.Voided || c.Status == CouponStatus.Void)
        {
            <div class="alert alert-secondary mt-3">คูปองนี้ถูกยกเลิก</div>
        }
        else
        {
            @* Available / Allocated — show the redeem button. *@
            @if (c.ExpiresAt is { } exp)
            {
                <p class="text-muted small mt-2">ใช้ได้ถึง @exp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            }
            @if (!string.IsNullOrWhiteSpace(c.BrandInstructions))
            {
                <p class="small mt-2">@c.BrandInstructions</p>
            }
            <form method="post" class="mt-3">
                <button type="submit" class="btn btn-lg w-100 text-white" style="background:@theme">
                    กดเพื่อรับคูปอง
                </button>
            </form>
            <p class="text-muted small mt-2">กดได้ครั้งเดียว — บาร์โค้ดจะแสดงหลังกดยืนยัน</p>
        }
    }
    </div>
</div>
</body>
</html>
