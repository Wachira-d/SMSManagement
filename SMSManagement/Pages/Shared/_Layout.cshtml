@using System.Security.Claims
@using System.Globalization
@inject SMSManagement.Modules.Core.Localization.Localizer Loc
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Campaign Platform</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { min-height: 100vh; display: flex; flex-direction: column; }
        main { flex: 1; }
        .navbar-brand { font-weight: 600; }
        .nav-tabs .nav-link { color: #495057; }
        .nav-tabs .nav-link.active { font-weight: 600; }
        .card-header { font-weight: 600; }
        pre { background: #f8f9fa; padding: 10px; border-radius: 4px; font-size: 12px; }
        .table-sm td, .table-sm th { padding: 0.4rem; font-size: 0.875rem; }
        .toast-container { position: fixed; top: 20px; right: 20px; z-index: 1080; }

        /* ---- Mobile-friendly tweaks ---- */
        @@media (max-width: 768px) {
            /* Project Detail has 9 tabs — wrap them in a horizontal scroller
               instead of letting the page overflow. */
            .nav-tabs { flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; }
            .nav-tabs .nav-link { white-space: nowrap; }
            /* Cards stack on mobile (handled by Bootstrap col grid) but the
               settings grid was a 2-col layout that overflowed on narrow
               phones — kill the side-by-side. */
            .row.g-3 > [class^="col-"] { margin-bottom: 0.5rem; }
            /* Tighten form controls inside cards. */
            .card-body .form-control,
            .card-body .form-select { font-size: 0.9rem; }
            /* Breadcrumb wraps when project names are long. */
            .breadcrumb { font-size: 0.875rem; }
        }
        /* Help long table content scroll horizontally without breaking layout
           (covers desktops with narrow window panes too). */
        .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

        /* Auto-refresh indicator — small dot pulsing next to "Recent" titles. */
        .refresh-dot {
            display: inline-block; width: 8px; height: 8px;
            border-radius: 50%; background: #28a745; margin-left: 6px;
            opacity: 0.6; animation: pulse 2s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50%      { opacity: 1;   transform: scale(1.2); }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
</head>
<body>
    @{ var isAuth = User?.Identity?.IsAuthenticated ?? false; }
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 p-2 bg-light"
       href="#mainContent">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <i class="bi bi-broadcast"></i> Campaign Platform
                </a>
                @if (isAuth)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navMain">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Projects/Index"
                                   data-hotkey="g p" title="Projects (g p)">
                                    <i class="bi bi-folder"></i> @Loc.Get("nav.projects")
                                </a>
                            </li>
                            <a hidden data-hotkey="g h" href="/Projects/Index"></a>
                            @if (User!.HasClaim("role", "system_admin"))
                            {
                                <a hidden data-hotkey="g a" href="/Admin/Users"></a>
                            }
                            @if (User!.HasClaim("perm", "audit.read") || User.HasClaim("role", "system_admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">
                                        <i class="bi bi-shield-lock"></i> @Loc.Get("nav.admin")
                                    </a>
                                    <ul class="dropdown-menu">
                                        @if (User.HasClaim("role", "system_admin"))
                                        {
                                            <li><h6 class="dropdown-header">Administration</h6></li>
                                            <li><a class="dropdown-item" asp-page="/Admin/Users">Users</a></li>
                                            <li><a class="dropdown-item" asp-page="/Admin/AllProjects">All projects</a></li>
                                            <li><a class="dropdown-item" asp-page="/Admin/Settings">System settings</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        <li><h6 class="dropdown-header">Operations</h6></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/Reports">Global reports</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/ErrorLogs">Error logs</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/BlockedIps">Blocked IPs</a></li>
                                        <li><a class="dropdown-item" asp-page="/Admin/ArchivedProjects">Archived projects</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/jobs" target="_blank">Hangfire dashboard</a></li>
                                        <li><a class="dropdown-item" href="/metrics" target="_blank">Metrics (/metrics)</a></li>
                                        <li><a class="dropdown-item" href="/health/ready" target="_blank">Health (/health/ready)</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#"
                                   title="Language">
                                    <i class="bi bi-translate" aria-hidden="true"></i>
                                    @CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToUpper()
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @foreach (var c in SMSManagement.Modules.Core.Localization.Localizer.SupportedCultures)
                                    {
                                        <li>
                                            <form method="post" action="/api/i18n/set-culture" class="px-2 py-1">
                                                <input type="hidden" name="culture" value="@c" />
                                                <input type="hidden" name="returnUrl"
                                                       value="@(Context.Request.Path + Context.Request.QueryString)" />
                                                <button type="submit"
                                                        class="btn btn-link p-0 dropdown-item @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == c ? "active" : "")">
                                                    @(c == "en" ? "English" : "ไทย")
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#"
                                   onclick="showHotkeyHelp();return false;"
                                   title="@Loc.Get("nav.shortcuts")">
                                    <i class="bi bi-keyboard" aria-hidden="true"></i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="#"
                                   onclick="openToastHistory();return false;"
                                   title="Notifications">
                                    <i class="bi bi-bell"></i>
                                    <span id="toastHistoryCount"
                                          class="badge rounded-pill bg-danger position-absolute d-none"
                                          style="top:0;right:0;font-size:.6rem">0</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#">
                                    <i class="bi bi-person-circle"></i>
                                    @(User!.FindFirstValue(ClaimTypes.Name) ?? User.FindFirstValue("sub") ?? "user")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted">
                                        @User.FindFirstValue(ClaimTypes.Email)
                                    </span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right"></i> @Loc.Get("nav.signout")
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>

    <main id="mainContent" class="container py-4" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3 small">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 Campaign Platform</span>
            <span>v@(typeof(Program).Assembly.GetName().Version?.ToString() ?? "0.0.0")</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        // Expose the current-culture dictionary so JS can do window.t(key) for
        // user-facing strings without round-tripping. Keys match Localizer.cs.
        window.__culture = '@CultureInfo.CurrentUICulture.Name';
        window.__i18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Loc.All()));
        window.t = function (key) { return (window.__i18n && window.__i18n[key]) || key; };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (isAuth)
    {
        <script>
            // Open the notifications hub for authenticated sessions. Failure to
            // connect (e.g. JWT just expired) doesn't break the page — silently
            // give up and the operator still sees the rest of the UI.
            (function () {
                if (!window.signalR) return;
                const conn = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/notifications')
                    .withAutomaticReconnect()
                    .build();
                conn.on('notify', (p) => {
                    if (window.toast) window.toast(
                        `<strong>${(p.title||'').replace(/</g,'&lt;')}</strong><br>${(p.body||'').replace(/</g,'&lt;')}`,
                        p.variant || 'info');
                });
                conn.start().catch(() => { /* silent */ });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
