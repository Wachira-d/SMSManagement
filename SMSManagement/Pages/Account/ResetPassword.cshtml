@page
@model SMSManagement.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reset password</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<div class="container py-5" style="max-width:480px">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h4 mb-3">Set a new password</h1>
            @if (string.IsNullOrWhiteSpace(Model.Token))
            {
                <div class="alert alert-danger">Reset link is missing the token. Use the link from your email.</div>
            }
            else
            {
                <form id="formReset">
                    <input id="token" type="hidden" value="@Model.Token" />
                    <div class="mb-2">
                        <label for="pw1" class="form-label">New password</label>
                        <input id="pw1" type="password" required minlength="8" class="form-control"
                               autocomplete="new-password" />
                        <div class="form-text">At least 8 characters.</div>
                    </div>
                    <div class="mb-3">
                        <label for="pw2" class="form-label">Confirm password</label>
                        <input id="pw2" type="password" required class="form-control"
                               autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Update password</button>
                </form>
                <div id="msg" class="alert mt-3 d-none small"></div>
            }
            <p class="text-center mt-3 mb-0 small">
                <a asp-page="/Account/Login">Back to login</a>
            </p>
        </div>
    </div>
</div>
<script>
const form = document.getElementById('formReset');
if (form) {
    form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const msg = document.getElementById('msg');
        msg.classList.remove('d-none', 'alert-danger', 'alert-success', 'alert-info');
        const pw1 = document.getElementById('pw1').value;
        const pw2 = document.getElementById('pw2').value;
        if (pw1 !== pw2) {
            msg.classList.add('alert-danger'); msg.textContent = 'Passwords do not match.'; return;
        }
        msg.classList.add('alert-info'); msg.textContent = 'Updating…';
        try {
            const resp = await fetch('/api/auth/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    token: document.getElementById('token').value,
                    newPassword: pw1
                })
            });
            const data = await resp.json();
            msg.classList.remove('alert-info');
            if (resp.ok) {
                msg.classList.add('alert-success');
                msg.textContent = (data.message || 'Done.') + ' Redirecting…';
                setTimeout(() => window.location = '/Account/Login', 1500);
            } else {
                msg.classList.add('alert-danger');
                msg.textContent = data.message || 'Reset failed.';
            }
        } catch (e) {
            msg.classList.add('alert-danger');
            msg.textContent = 'Network error: ' + e.message;
        }
    });
}
</script>
</body>
</html>
