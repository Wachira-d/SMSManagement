@page
@model SMSManagement.Pages.Admin.EmailLogsModel
@{ ViewData["Title"] = "Email logs"; }

<h1 class="h3 mb-3">Email logs</h1>
<p class="text-muted small">
    Every email the platform sends, whichever transport carried it, and every
    delivery webhook EmailRelayAPI posted back. A relay email normally goes
    <span class="badge bg-info text-dark">Queued</span> →
    <span class="badge bg-success">Sent</span> within seconds. If it stays Queued,
    the webhook didn't arrive. The reconciler pulls the status every 10 minutes,
    or you can click <b>Refresh</b> on the email.
</p>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-emails">Emails</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-hooks">Webhook calls</a></li>
</ul>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small">From</label>
        <input type="date" id="fromDate" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label small">To</label>
        <input type="date" id="toDate" class="form-control form-control-sm" />
    </div>
</div>

<div class="tab-content">
    <!-- ============ EMAILS ============ -->
    <div class="tab-pane fade show active" id="tab-emails">
        <div class="row g-2 mb-3 align-items-end">
            <div class="col-auto">
                <label class="form-label small">Status</label>
                <select id="statusFilter" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option>Pending</option><option>Queued</option><option>Scheduled</option>
                    <option>Sending</option><option>Sent</option><option>Failed</option>
                    <option>Cancelled</option><option>Rejected</option><option>Skipped</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">Provider</label>
                <select id="providerFilter" class="form-select form-select-sm">
                    <option value="">All</option><option value="relay">relay</option><option value="smtp">smtp</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">Category</label>
                <select id="categoryFilter" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option>ingestion-report</option><option>sms-round-summary</option>
                    <option>coupon-shortage</option><option>password-reset</option><option>admin-test</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">Search</label>
                <input id="searchFilter" class="form-control form-control-sm" placeholder="recipient, subject or relay id" />
            </div>
            <div class="col-auto">
                <button id="btnSearch" class="btn btn-primary btn-sm">Search</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr>
                    <th>When</th><th>Status</th><th>Provider</th><th>Category</th>
                    <th>To</th><th>Subject</th><th>Error</th>
                </tr></thead>
                <tbody id="emBody"><tr><td colspan="7" class="text-muted">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="d-flex align-items-center gap-2 mb-4">
            <button id="emPrev" class="btn btn-outline-secondary btn-sm" disabled>&laquo; Prev</button>
            <button id="emNext" class="btn btn-outline-secondary btn-sm" disabled>Next &raquo;</button>
            <span id="emInfo" class="small text-muted"></span>
        </div>
    </div>

    <!-- ============ WEBHOOK CALLS ============ -->
    <div class="tab-pane fade" id="tab-hooks">
        <div class="row g-2 mb-3 align-items-end">
            <div class="col-auto">
                <label class="form-label small">Outcome</label>
                <select id="hookOutcome" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option>applied</option><option>duplicate</option><option>ignored-stale</option>
                    <option>unknown-message</option><option>bad-signature</option><option>missing-signature</option>
                    <option>stale-timestamp</option><option>parse-error</option><option>disabled</option>
                </select>
            </div>
            <div class="col-auto"><button id="btnHookSearch" class="btn btn-primary btn-sm">Search</button></div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>When</th><th>Outcome</th><th>Event</th><th>Relay id</th><th>Remote IP</th><th>Notes</th></tr></thead>
                <tbody id="hkBody"><tr><td colspan="6" class="text-muted">Loading…</td></tr></tbody>
            </table>
        </div>
        <div class="d-flex align-items-center gap-2 mb-4">
            <button id="hkPrev" class="btn btn-outline-secondary btn-sm" disabled>&laquo; Prev</button>
            <button id="hkNext" class="btn btn-outline-secondary btn-sm" disabled>Next &raquo;</button>
            <span id="hkInfo" class="small text-muted"></span>
        </div>
    </div>
</div>

<div class="modal fade" id="emModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Email detail</h5>
                <button id="btnRefresh" class="btn btn-outline-primary btn-sm ms-3 d-none" type="button">
                    <i class="bi bi-arrow-repeat"></i> Refresh from relay</button>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <dl id="emSummary" class="row mb-3 small"></dl>
                <h6 class="small text-muted mb-1">Webhook calls for this email</h6>
                <div id="emHooks" class="small"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="hkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Webhook call</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <dl id="hkSummary" class="row mb-3 small"></dl>
                <pre id="hkRaw" class="small bg-light p-2" style="max-height:50vh;overflow:auto"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const to = new Date();
    const from = new Date(); from.setDate(from.getDate() - 7);
    document.getElementById('fromDate').value = from.toISOString().slice(0,10);
    document.getElementById('toDate').value   = to.toISOString().slice(0,10);
})();

let emPage = 1, hkPage = 1, currentId = null;

const STATUS_CLASS = {
    Pending: 'bg-secondary', Queued: 'bg-info text-dark', Scheduled: 'bg-info text-dark',
    Sending: 'bg-info text-dark', Sent: 'bg-success', Failed: 'bg-danger',
    Cancelled: 'bg-secondary', Rejected: 'bg-danger', Skipped: 'bg-warning text-dark'
};
const OUTCOME_CLASS = {
    'applied': 'bg-success', 'duplicate': 'bg-secondary', 'ignored-stale': 'bg-secondary',
    'unknown-message': 'bg-warning text-dark', 'bad-signature': 'bg-danger',
    'missing-signature': 'bg-danger', 'stale-timestamp': 'bg-danger',
    'parse-error': 'bg-danger', 'disabled': 'bg-warning text-dark'
};
const badge = (map, v) => `<span class="badge ${map[v] || 'bg-secondary'}">${esc(v || '')}</span>`;

function rangeQs() {
    return new URLSearchParams({
        from: document.getElementById('fromDate').value + 'T00:00:00Z',
        to:   document.getElementById('toDate').value + 'T23:59:59Z'
    });
}
function pager(prefix, data, noun) {
    document.getElementById(prefix + 'Info').textContent = data.total === 0
        ? `No ${noun}` : `Page ${data.page} of ${data.totalPages} — ${data.total} ${noun}`;
    document.getElementById(prefix + 'Prev').disabled = data.page <= 1;
    document.getElementById(prefix + 'Next').disabled = data.page >= data.totalPages;
}

async function loadEmails() {
    const qs = rangeQs();
    qs.set('page', emPage); qs.set('pageSize', 50);
    for (const [k, id] of [['status','statusFilter'],['provider','providerFilter'],['category','categoryFilter'],['search','searchFilter']]) {
        const v = document.getElementById(id).value.trim();
        if (v) qs.set(k, v);
    }
    try {
        const data = await api.get('/api/admin/email-logs?' + qs);
        pager('em', data, 'emails');
        const body = document.getElementById('emBody');
        if (!data.items.length) { body.innerHTML = '<tr><td colspan="7" class="text-muted">No emails in this range.</td></tr>'; return; }
        body.innerHTML = data.items.map(r => `
            <tr style="cursor:pointer" onclick="showEmail('${r.id}')">
                <td class="small text-nowrap">${fmtDate(r.createdAt)}</td>
                <td>${badge(STATUS_CLASS, r.status)}</td>
                <td class="small">${esc(r.provider)}</td>
                <td class="small">${esc(r.category || '')}</td>
                <td class="small text-truncate" style="max-width:220px">${esc(r.recipients)}</td>
                <td class="small text-truncate" style="max-width:280px">${esc(r.subject)}</td>
                <td class="small text-danger text-truncate" style="max-width:260px">${esc(r.lastError || '')}</td>
            </tr>`).join('');
    } catch (e) { toast(e.message, 'danger'); }
}

async function loadHooks() {
    const qs = rangeQs();
    qs.set('page', hkPage); qs.set('pageSize', 50);
    const o = document.getElementById('hookOutcome').value;
    if (o) qs.set('outcome', o);
    try {
        const data = await api.get('/api/admin/email-logs/webhooks?' + qs);
        pager('hk', data, 'calls');
        window._hooks = Object.fromEntries(data.items.map(h => [h.id, h]));
        const body = document.getElementById('hkBody');
        if (!data.items.length) { body.innerHTML = '<tr><td colspan="6" class="text-muted">No webhook calls in this range.</td></tr>'; return; }
        body.innerHTML = data.items.map(h => `
            <tr style="cursor:pointer" onclick="showHook(${h.id})">
                <td class="small text-nowrap">${fmtDate(h.createdAt)}</td>
                <td>${badge(OUTCOME_CLASS, h.outcome)}</td>
                <td class="small">${esc(h.event || '')}</td>
                <td class="small"><code>${esc(h.relayMessageId || '—')}</code></td>
                <td class="small">${esc(h.remoteIp || '')}</td>
                <td class="small text-truncate" style="max-width:360px">${esc(h.notes || '')}</td>
            </tr>`).join('');
    } catch (e) { toast(e.message, 'danger'); }
}

const item = (k, v) => v == null || v === '' ? ''
    : `<dt class="col-sm-3">${esc(k)}</dt><dd class="col-sm-9">${v}</dd>`;

function renderEmail(e, hooks) {
    document.getElementById('emSummary').innerHTML = [
        item('Created',        fmtDate(e.createdAt)),
        item('Status',         badge(STATUS_CLASS, e.status) + (e.statusSource ? ` <span class="text-muted">via ${esc(e.statusSource)} ${e.statusUpdatedAt ? fmtDate(e.statusUpdatedAt) : ''}</span>` : '')),
        item('Provider',       esc(e.provider)),
        item('Category',       esc(e.category)),
        item('To',             esc(e.recipients)),
        item('Subject',        esc(e.subject)),
        item('Attachments',    e.attachmentCount ? String(e.attachmentCount) : ''),
        item('Sent at',        e.sentAt ? fmtDate(e.sentAt) : ''),
        item('Relay id',       e.relayMessageId ? `<code>${esc(e.relayMessageId)}</code>` : ''),
        item('Idempotency key', `<code>${esc(e.idempotencyKey || '')}</code>`),
        item('Provider msg id', e.providerMessageId ? `<code>${esc(e.providerMessageId)}</code>` : ''),
        item('Attempts',       e.attempts ? String(e.attempts) : ''),
        item('Last polled',    e.lastPolledAt ? fmtDate(e.lastPolledAt) : ''),
        item('Error',          e.lastError ? `<span class="text-danger">${esc(e.lastError)}</span>` : '')
    ].join('');
    document.getElementById('emHooks').innerHTML = hooks.length
        ? '<ul class="list-unstyled mb-0">' + hooks.map(h =>
            `<li>${fmtDate(h.createdAt)} ${badge(OUTCOME_CLASS, h.outcome)} ${esc(h.event || '')} ${esc(h.notes || '')}</li>`).join('') + '</ul>'
        : '<span class="text-muted">None yet.</span>';
    document.getElementById('btnRefresh').classList.toggle('d-none', e.provider !== 'relay');
}

window.showEmail = async function (id) {
    currentId = id;
    try {
        const d = await api.get('/api/admin/email-logs/' + id);
        renderEmail(d.email, d.webhooks || []);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('emModal')).show();
    } catch (e) { toast(e.message, 'danger'); }
};

window.showHook = function (id) {
    const h = window._hooks[id];
    if (!h) return;
    document.getElementById('hkSummary').innerHTML = [
        item('When', fmtDate(h.createdAt)), item('Outcome', badge(OUTCOME_CLASS, h.outcome)),
        item('Event', esc(h.event)), item('Relay id', h.relayMessageId ? `<code>${esc(h.relayMessageId)}</code>` : ''),
        item('Remote IP', esc(h.remoteIp)), item('Notes', esc(h.notes))
    ].join('');
    let raw = h.rawPayload || '';
    try { raw = JSON.stringify(JSON.parse(raw), null, 2); } catch { /* leave as-is */ }
    document.getElementById('hkRaw').textContent = raw;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('hkModal')).show();
};

document.getElementById('btnRefresh').addEventListener('click', async () => {
    if (!currentId) return;
    try {
        const r = await api.post('/api/admin/email-logs/' + currentId + '/refresh', {});
        toast('Relay: ' + r.outcome, r.outcome.startsWith('error') ? 'danger' : 'success');
        const d = await api.get('/api/admin/email-logs/' + currentId);
        renderEmail(d.email, d.webhooks || []);
        loadEmails();
    } catch (e) { toast(e.message, 'danger'); }
});

document.getElementById('btnSearch').addEventListener('click', () => { emPage = 1; loadEmails(); });
document.getElementById('btnHookSearch').addEventListener('click', () => { hkPage = 1; loadHooks(); });
document.getElementById('emPrev').addEventListener('click', () => { if (emPage > 1) { emPage--; loadEmails(); } });
document.getElementById('emNext').addEventListener('click', () => { emPage++; loadEmails(); });
document.getElementById('hkPrev').addEventListener('click', () => { if (hkPage > 1) { hkPage--; loadHooks(); } });
document.getElementById('hkNext').addEventListener('click', () => { hkPage++; loadHooks(); });
for (const id of ['fromDate', 'toDate']) document.getElementById(id).addEventListener('change', () => { emPage = hkPage = 1; loadEmails(); loadHooks(); });
loadEmails();
loadHooks();
</script>
}
