@page
@model SMSManagement.Pages.Admin.ReportsModel
@inject SMSManagement.Modules.Core.Localization.Localizer Loc
@{ ViewData["Title"] = Loc.Get("admin.reports.title"); }

<h1 class="h3 mb-3">@Loc.Get("admin.reports.title")</h1>
<p class="text-muted small">
    Cross-project aggregates — requires <code>audit.read</code> permission.
    Use these to compare provider quality across all your campaigns and to
    spot anomalous user activity.
</p>

<div class="row g-2 mb-2">
    <div class="col-12">
        <!-- Date-range presets backed by site.js helper. The two date inputs
             below are still the source of truth; the buttons just set them. -->
        <div class="btn-group btn-group-sm" id="rptRangeGroup" role="group" aria-label="Date range preset">
            <button type="button" class="btn btn-outline-secondary" data-range="today">@Loc.Get("range.today")</button>
            <button type="button" class="btn btn-outline-secondary" data-range="yesterday">@Loc.Get("range.yesterday")</button>
            <button type="button" class="btn btn-outline-secondary active" data-range="last7">@Loc.Get("range.last7")</button>
            <button type="button" class="btn btn-outline-secondary" data-range="last30">@Loc.Get("range.last30")</button>
            <button type="button" class="btn btn-outline-secondary" data-range="mtd">@Loc.Get("range.mtd")</button>
            <button type="button" class="btn btn-outline-secondary" data-range="qtd">@Loc.Get("range.qtd")</button>
        </div>
    </div>
</div>
<div class="row g-2 mb-3 align-items-center">
    <div class="col-auto"><input type="date" id="rptFrom" class="form-control form-control-sm" /></div>
    <div class="col-auto"><input type="date" id="rptTo" class="form-control form-control-sm" /></div>
    <div class="col-auto">
        <select id="rptKind" class="form-select form-select-sm">
            <option value="provider-performance">Provider Performance</option>
            <option value="user-activity">User Activity</option>
        </select>
    </div>
    <div class="col-auto"><button id="btnRpt" class="btn btn-primary btn-sm">Run</button></div>
    <div class="col-auto"><a id="btnCsv" class="btn btn-outline-secondary btn-sm">CSV</a></div>
</div>

<div class="card mb-3">
    <div class="card-body" style="position:relative; height:260px">
        <canvas id="rptChart"></canvas>
    </div>
</div>
<div id="rptOut" class="card"><div class="card-body text-muted small">
    Pick a date range + report and click Run.
</div></div>

@section Scripts {
<script>
(function () {
    // Init via the shared site.js helper. It seeds Last 7d (matches the
    // active preset above) and fires a 'rangechange' event on subsequent
    // preset clicks.
    window.initDateRangePresets('#rptRangeGroup', '#rptFrom', '#rptTo');
    document.querySelector('#rptRangeGroup [data-range="last7"]').click();
})();

function qs() {
    const from = document.getElementById('rptFrom').value;
    const to   = document.getElementById('rptTo').value;
    return `?from=${from}T00:00:00Z&to=${to}T23:59:59Z`;
}

let chartInstance = null;
document.getElementById('btnRpt').addEventListener('click', async () => {
    const kind = document.getElementById('rptKind').value;
    try {
        const data = await api.get(`/api/reports/${kind}${qs()}`);
        const out = document.getElementById('rptOut');
        if (!Array.isArray(data) || !data.length) {
            out.innerHTML = '<div class="card-body text-muted small">No data in this range.</div>';
            if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
            return;
        }
        const cols = Object.keys(data[0]);
        out.innerHTML = `
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead><tr>${cols.map(c => `<th>${esc(c)}</th>`).join('')}</tr></thead>
              <tbody>${data.map(r => `<tr>${cols.map(c =>
                  `<td>${typeof r[c] === 'number' && r[c] < 1 && r[c] > 0
                      ? (r[c]*100).toFixed(1) + '%'
                      : esc(String(r[c] ?? ''))}</td>`).join('')}</tr>`).join('')}
              </tbody>
            </table>
          </div>`;
        renderChart(kind, data);
    } catch (e) { toast(e.message, 'danger'); }
});

// Bar chart per report kind — provider perf shows volume + delivery rate;
// user activity shows top users by total actions. Chart.js handles legend
// + tooltips by default, so we only feed it labels + datasets.
function renderChart(kind, data) {
    if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
    const ctx = document.getElementById('rptChart');
    if (!ctx) return;

    let cfg;
    if (kind === 'provider-performance') {
        cfg = {
            type: 'bar',
            data: {
                labels: data.map(r => r.provider),
                datasets: [
                    { label: 'Volume',         data: data.map(r => r.volume), yAxisID: 'y' },
                    { label: 'Delivery rate %', data: data.map(r => (r.deliveryRate * 100).toFixed(1)),
                      yAxisID: 'y1', type: 'line', tension: 0.3 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: {
                    y:  { beginAtZero: true, title: { display: true, text: 'Volume' } },
                    y1: { beginAtZero: true, max: 100, position: 'right', grid: { drawOnChartArea: false },
                          title: { display: true, text: 'Delivery %' } }
                }
            }
        };
    } else {
        const top = data.slice(0, 10);
        cfg = {
            type: 'bar',
            data: {
                labels: top.map(r => r.email || r.displayName || (r.userId || '').slice(0, 8)),
                datasets: [{ label: 'Total actions', data: top.map(r => r.totalActions) }]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                scales: { x: { beginAtZero: true } }
            }
        };
    }
    chartInstance = new Chart(ctx, cfg);
}

document.getElementById('btnCsv').addEventListener('click', () => {
    document.getElementById('btnCsv').href =
        `/api/reports/${document.getElementById('rptKind').value}/export.csv${qs()}`;
});
</script>
}
