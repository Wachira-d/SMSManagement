                                <input id="cpnImpExpiry" type="datetime-local" class="form-control form-control-sm" /></div>
                            <div class="col-md-2"><label class="form-label small">Token len</label>
                                <input id="cpnImpTokenLen" type="number" min="4" max="32" value="10" class="form-control form-control-sm" /></div>
                            <div class="col-md-2"><label class="form-label small">Code column</label>
                                <input id="cpnImpCol" class="form-control form-control-sm" placeholder="(first)" /></div>
                            <div class="col-12"><label class="form-label small">Token alphabet</label>
                                <input id="cpnImpAlpha" class="form-control form-control-sm"
                                       value="ABCDEFGHJKLMNPQRSTUVWXYZ23456789" /></div>
                            <div class="col-12"><label class="form-label small">File (CSV / XLSX — real brand codes)</label>
                                <input id="cpnImpFile" type="file" accept=".csv,.xlsx,.xls" class="form-control form-control-sm" required /></div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-upload"></i> Import
                                </button>
                            </div>
                        </form>
                        <div id="cpnImportResult" class="mt-2"></div>
                    </div>
                </div>
                <div class="card mt-2">
                    <div class="card-header">Batches <small class="text-muted">— click a row to view coupons</small></div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Name</th><th>Brand</th><th class="text-end">Total</th>
                                <th class="text-end">Allocated</th><th class="text-end">Redeemed</th>
                                <th class="text-end">Redeem %</th></tr></thead>
                            <tbody id="cpnBatchBody"><tr><td colspan="6" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
                <div id="cpnInventoryCard" class="card mt-2" style="display:none">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Coupons — <span id="cpnInvBatchName"></span></span>
                        <select id="cpnInvStatus" class="form-select form-select-sm" style="width:auto">
                            <option value="">All statuses</option>
                            <option value="0">Available</option>
                            <option value="1">Allocated</option>
                            <option value="2">Redeemed</option>
                            <option value="3">Expired</option>
                            <option value="4">Void</option>
                        </select>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Token</th><th>Status</th><th class="text-end">Value</th>
                                <th>Allocated</th><th>Redeemed</th><th></th></tr></thead>
                            <tbody id="cpnInvBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ REPORTS ============ -->
    <div class="tab-pane fade" id="tab-reports">
        <div class="row g-2 mb-3">
            <div class="col-auto"><input type="date" id="rptFrom" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" id="rptTo" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <select id="rptKind" class="form-select form-select-sm">
                    <option value="sms-campaign">SMS Campaign</option>
                    <option value="delivery-funnel">Delivery Funnel</option>
                    <option value="shortlinks">Shortlinks</option>
                    <option value="reminder-effectiveness">Reminders</option>
                    <option value="ingestion-quality">Ingestion Quality</option>
                    <option value="audit-trail">Audit Trail</option>
                </select>
            </div>
            <div class="col-auto">
                <button id="btnRpt" class="btn btn-primary btn-sm">Run</button>
                <a id="btnCsv" class="btn btn-outline-secondary btn-sm">CSV</a>
            </div>
        </div>
        <div id="rptOut" class="card"><div class="card-body text-muted small">
            Pick a date range + report and click Run.
        </div></div>
    </div>

    <!-- ============ AUDIT ============ -->
    <div class="tab-pane fade" id="tab-audit">
        <div class="mb-2">
            <div class="btn-group btn-group-sm" id="audRangeGroup" role="group">
                <button type="button" class="btn btn-outline-secondary" data-range="today">@Loc.Get("range.today")</button>
                <button type="button" class="btn btn-outline-secondary" data-range="yesterday">@Loc.Get("range.yesterday")</button>
                <button type="button" class="btn btn-outline-secondary active" data-range="last7">@Loc.Get("range.last7")</button>
                <button type="button" class="btn btn-outline-secondary" data-range="last30">@Loc.Get("range.last30")</button>
                <button type="button" class="btn btn-outline-secondary" data-range="mtd">@Loc.Get("range.mtd")</button>
            </div>
        </div>
        <div class="row g-2 mb-3 align-items-center">
            <div class="col-auto"><input type="date" id="audFrom" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" id="audTo" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <select id="audUserPick" class="form-select form-select-sm"
                        aria-label="Filter by user">
                    <option value="">All users</option>
                </select>
            </div>
            <div class="col-auto">
                <select id="audActionPick" class="form-select form-select-sm"
                        aria-label="Filter by action">
                    <option value="">All actions</option>
                </select>
            </div>
            <div class="col-auto">
                <input id="audFilter" type="search" class="form-control form-control-sm"
                       placeholder="Search text…" aria-label="Filter rows by free text"
                       data-filter-target="#audBody" style="width:200px" />
            </div>
            <div class="col-auto">
                <button id="btnAud" class="btn btn-primary btn-sm">Load</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm" data-sortable>
                <thead><tr>
                    <th data-sort="date">When</th>
                    <th data-sort="str">User</th>
                    <th data-sort="str">Action</th>
                    <th data-sort="str">Entity</th>
                    <th data-sort="str">IP</th>
                </tr></thead>
                <tbody id="audBody"><tr><td colspan="5" class="text-muted">Pick a range and click Load.</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<input type="hidden" id="projectId" value="@Model.ProjectId" />

<!-- ============ DRILL-DOWN MODALS ============ -->
<div class="modal fade" id="smsDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">SMS detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><pre id="smsDetailBody" class="small">Loading…</pre></div>
        </div>
    </div>
</div>

<div class="modal fade" id="slClicksModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Click history</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <table class="table table-sm">
                    <thead><tr><th>When</th><th>Device</th><th>Country</th><th>User-Agent</th></tr></thead>
                    <tbody id="slClicksBody"><tr><td colspan="4" class="text-muted">Loading…</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Per-batch rejection sample. Surfaces the WHY behind the "X rejected" count
     on the Sources tab batches list without making the operator dig through logs. -->
<div class="modal fade" id="rejectionsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-x-octagon"></i> Rejected rows</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="rejectionsBody">Loading…</div>
        </div>
    </div>
</div>

<div class="modal fade" id="runDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-diagram-3"></i> รายละเอียดการรัน</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="runDetailBody">กำลังโหลด…</div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/project-detail.js" asp-append-version="true"></script>
}
