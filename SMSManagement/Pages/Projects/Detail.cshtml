@page "{handler?}"
@model SMSManagement.Pages.Projects.DetailModel
@{ ViewData["Title"] = "Project"; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Projects/Index">Projects</a></li>
        <li class="breadcrumb-item active" id="bcName">…</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-baseline mb-3">
    <h1 class="h3 mb-0" id="projName">Loading…</h1>
    <span class="text-muted" id="projCode"></span>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-settings">Settings</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-members">Members</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-mappings">Mappings</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-sources">Sources</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-workflows">Workflows</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-sms">SMS</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-shortlinks">Shortlinks</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-reports">Reports</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-audit">Audit</a></li>
</ul>

<div class="tab-content">
    <!-- ============ SETTINGS ============ -->
    <div class="tab-pane fade show active" id="tab-settings">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Project info</div>
                    <div class="card-body">
                        <form id="formInfo">
                            <div class="mb-2">
                                <label class="form-label small">Name</label>
                                <input id="setName" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Default SMS provider</label>
                                <select id="setProvider" class="form-select">
                                    <option value="etracker">Etracker</option>
                                    <option value="infobip">Infobip</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Features enabled</div>
                    <div class="card-body">
                        <form id="formFeatures">
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featSms"><label class="form-check-label" for="featSms">SMS dispatch</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featShortlink"><label class="form-check-label" for="featShortlink">Shortlinks</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featWorkflow"><label class="form-check-label" for="featWorkflow">Workflow engine</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featIngestion"><label class="form-check-label" for="featIngestion">Ingestion (upload/SFTP)</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featEmail"><label class="form-check-label" for="featEmail">Email alerts</label></div>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Shortlink generation</div>
                    <div class="card-body">
                        <form id="formShortlink">
                            <div class="mb-2">
                                <label class="form-label small">Slug length (4-16)</label>
                                <input id="slLength" type="number" min="4" max="16" class="form-control" />
                                <div class="form-text">Blank = use platform default (8).</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Custom alphabet</label>
                                <input id="slAlpha" class="form-control" maxlength="80"
                                       pattern="[A-Za-z0-9_\-]+"
                                       placeholder="A-Z a-z 0-9 _ - (10–80 unique chars; case-sensitive)" />
                                <div class="form-text">Blank = default 57-char URL-safe alphabet.</div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Email notifications</div>
                    <div class="card-body">
                        <form id="formNotif">
                            <div class="mb-2">
                                <label class="form-label small">Recipients (comma-separated)</label>
                                <input id="notifEmails" class="form-control" placeholder="ops@x.com, mgr@x.com" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Subject prefix</label>
                                <input id="notifPrefix" class="form-control" placeholder="[Project name]" />
                            </div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifSuccess"><label class="form-check-label" for="notifSuccess">Notify on ingest success</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifPartial"><label class="form-check-label" for="notifPartial">Notify on partial</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifFailure"><label class="form-check-label" for="notifFailure">Notify on failure</label></div>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-12" id="dangerZone" style="display:none">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">Danger zone</div>
                    <div class="card-body">
                        <button id="btnArchive" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-archive"></i> Archive project
                        </button>
                        <span class="text-muted small ms-2">
                            Hides the project + cancels in-flight workflows and queued SMS.
                            Reversible by an admin.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ MEMBERS ============ -->
    <div class="tab-pane fade" id="tab-members">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">Members</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>User</th><th>Email</th><th>Level</th><th>Granted</th><th></th></tr>
                            </thead>
                            <tbody id="membersBody"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">Share project</div>
                    <div class="card-body">
                        <form id="formShare">
                            <div class="mb-2">
                                <label class="form-label small">User ID (Guid)</label>
                                <input id="shareUserId" class="form-control" placeholder="00000000-..." required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Level</label>
                                <select id="shareLevel" class="form-select">
                                    <option value="Viewer">Viewer (read-only)</option>
                                    <option value="Member">Member (use features)</option>
                                    <option value="Admin">Admin (configure + share)</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Share</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ MAPPINGS ============ -->
    <div class="tab-pane fade" id="tab-mappings">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">Column mappings</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Source column</th><th>→</th><th>Canonical</th><th>Transforms</th><th></th></tr></thead>
                            <tbody id="mapBody"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">Add / update mapping</div>
                    <div class="card-body">
                        <form id="formMap">
                            <div class="mb-2"><label class="form-label small">Source column header</label>
                                <input id="mapSource" class="form-control" required /></div>
                            <div class="mb-2"><label class="form-label small">Canonical field</label>
                                <select id="mapField" class="form-select">
                                    <option>phone</option><option>message</option><option>url</option>
                                    <option>name</option><option>email</option><option>custom</option>
                                </select></div>
                            <div class="mb-2"><label class="form-label small">Transforms (in order)</label>
                                <input id="mapChain" class="form-control"
                                       placeholder="trim, digits, prefix_66" /></div>
                            <button type="submit" class="btn btn-primary btn-sm">Upsert</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SOURCES ============ -->
    <div class="tab-pane fade" id="tab-sources">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">Ingestion source bindings</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Type</th><th>Archive dir</th><th>Action</th><th>Dup</th><th>On</th><th></th></tr></thead>
                            <tbody id="srcBody"><tr><td colspan="6" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">Manual file upload</div>
                    <div class="card-body">
                        <form id="formUpload" enctype="multipart/form-data">
                            <div class="mb-2"><label class="form-label small">Source binding ID (Guid)</label>
                                <input id="upSrcId" class="form-control" required
                                       placeholder="paste from sources table" /></div>
                            <div class="mb-2"><label class="form-label small">File (.csv or .xlsx)</label>
                                <input id="upFile" type="file" class="form-control" accept=".csv,.xlsx" required /></div>
                            <div class="form-check"><input type="checkbox" id="upForce" class="form-check-input">
                                <label class="form-check-label small" for="upForce">Force re-ingest (bypass dedup)</label></div>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Upload</button>
                        </form>
                        <pre id="upResult" class="mt-3 d-none"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ WORKFLOWS ============ -->
    <div class="tab-pane fade" id="tab-workflows">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <span>Definitions</span>
                        <button class="btn btn-sm btn-link p-0" id="btnWfNew">New</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Name</th><th>v</th><th>Active</th><th></th></tr></thead>
                            <tbody id="wfBody"><tr><td colspan="4" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header" id="wfEditTitle">Editor</div>
                    <div class="card-body">
                        <div class="mb-2"><label class="form-label small">Workflow name</label>
                            <input id="wfName" class="form-control" placeholder="reminder-flow" /></div>
                        <div class="mb-2"><label class="form-label small">Spec (JSON)</label>
                            <textarea id="wfSpec" class="form-control font-monospace" rows="14"
                                      spellcheck="false"></textarea></div>
                        <button id="btnWfSave" class="btn btn-primary btn-sm">Save as new version</button>
                        <span class="text-muted small ms-2">
                            Server validates the DAG before insert.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SMS ============ -->
    <div class="tab-pane fade" id="tab-sms">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Send SMS</div>
                    <div class="card-body">
                        <form id="formSms">
                            <div class="mb-2"><label class="form-label small">Recipient (E.164)</label>
                                <input id="smsTo" class="form-control" required placeholder="66812345678" /></div>
                            <div class="mb-2"><label class="form-label small">Message body</label>
                                <textarea id="smsBody" class="form-control" rows="4" required></textarea></div>
                            <div class="mb-2"><label class="form-label small">Sender ID (optional)</label>
                                <input id="smsFrom" class="form-control" placeholder="default per provider" /></div>
                            <div class="mb-2"><label class="form-label small">Schedule for (optional)</label>
                                <input id="smsSched" type="datetime-local" class="form-control" /></div>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-send"></i> Dispatch
                            </button>
                        </form>
                        <pre id="smsResult" class="mt-3 d-none"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SHORTLINKS ============ -->
    <div class="tab-pane fade" id="tab-shortlinks">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">Shortlinks</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Slug</th><th>Clicks</th><th>Expires</th><th>Disabled</th><th></th></tr></thead>
                            <tbody id="slBody"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">Create shortlink</div>
                    <div class="card-body">
                        <form id="formSlCreate">
                            <div class="mb-2"><label class="form-label small">Target URL</label>
                                <input id="slUrl" type="url" class="form-control" required
                                       placeholder="https://example.com/landing" /></div>
                            <div class="mb-2"><label class="form-label small">Lifetime (days, optional)</label>
                                <input id="slDays" type="number" min="1" max="365" class="form-control" /></div>
                            <div class="mb-2"><label class="form-label small">Max clicks (optional)</label>
                                <input id="slMax" type="number" min="1" class="form-control" /></div>
                            <button type="submit" class="btn btn-primary btn-sm">Create</button>
                        </form>
                        <div id="slCreated" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ REPORTS ============ -->
    <div class="tab-pane fade" id="tab-reports">
        <div class="row g-2 mb-3">
            <div class="col-auto"><input type="date" id="rptFrom" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" id="rptTo" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <select id="rptKind" class="form-select form-select-sm">
                    <option value="sms-campaign">SMS Campaign</option>
                    <option value="delivery-funnel">Delivery Funnel</option>
                    <option value="shortlinks">Shortlinks</option>
                    <option value="reminder-effectiveness">Reminders</option>
                    <option value="ingestion-quality">Ingestion Quality</option>
                </select>
            </div>
            <div class="col-auto">
                <button id="btnRpt" class="btn btn-primary btn-sm">Run</button>
                <a id="btnCsv" class="btn btn-outline-secondary btn-sm">CSV</a>
            </div>
        </div>
        <div id="rptOut" class="card"><div class="card-body text-muted small">
            Pick a date range + report and click Run.
        </div></div>
    </div>

    <!-- ============ AUDIT ============ -->
    <div class="tab-pane fade" id="tab-audit">
        <div class="row g-2 mb-3">
            <div class="col-auto"><input type="date" id="audFrom" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" id="audTo" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <button id="btnAud" class="btn btn-primary btn-sm">Load</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th></tr></thead>
                <tbody id="audBody"><tr><td colspan="5" class="text-muted">Pick a range and click Load.</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<input type="hidden" id="projectId" value="@Model.ProjectId" />

@section Scripts {
<script src="~/js/project-detail.js" asp-append-version="true"></script>
}
