                        <table class="table table-sm mb-0">
                            <thead><tr><th>Created</th><th>To</th><th>Provider</th><th>Status</th><th>Attempts</th></tr></thead>
                            <tbody id="smsListBody"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Per-project provider credentials. Admin-only. Secrets never come back over GET. -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Provider credentials (per project)</span>
                        <small class="text-muted">Blank fields fall back to the global default. Secrets are stored encrypted and never returned by the API.</small>
                    </div>
                    <div class="card-body">
                        <ul class="nav nav-pills mb-3" role="tablist">
                            <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#prov-etracker">MacroKiosk</a></li>
                            <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#prov-infobip">Infobip</a></li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="prov-etracker">
                                <form id="formProvEtracker" class="row g-2">
                                    <div class="col-md-6"><label class="form-label small">Base URL</label>
                                        <input id="etBaseUrl" class="form-control form-control-sm" placeholder="https://www.etracker.cc/bulksms/mesapi.aspx" /></div>
                                    <div class="col-md-6"><label class="form-label small">Username</label>
                                        <input id="etUser" class="form-control form-control-sm" autocomplete="off" /></div>
                                    <div class="col-md-6"><label class="form-label small">Password <span id="etPwdMark" class="badge text-bg-secondary d-none">stored</span></label>
                                        <input id="etPwd" type="password" class="form-control form-control-sm" autocomplete="new-password" placeholder="leave blank to keep current" /></div>
                                    <div class="col-md-4"><label class="form-label small">Default Sender ID</label>
                                        <input id="etSender" class="form-control form-control-sm" /></div>
                                    <div class="col-md-2"><label class="form-label small">Default Type</label>
                                        <input id="etType" class="form-control form-control-sm" placeholder="0" /></div>
                                    <div class="col-12 d-flex gap-2">
                                        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save"></i> Save</button>
                                        <button type="button" id="btnEtClear" class="btn btn-outline-danger btn-sm">Remove override</button>
                                        <span id="etStatus" class="ms-auto small text-muted"></span>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="prov-infobip">
                                <form id="formProvInfobip" class="row g-2">
                                    <div class="col-md-6"><label class="form-label small">Base URL</label>
                                        <input id="ibBaseUrl" class="form-control form-control-sm" placeholder="https://api.infobip.com" /></div>
                                    <div class="col-md-6"><label class="form-label small">API Key <span id="ibKeyMark" class="badge text-bg-secondary d-none">stored</span></label>
                                        <input id="ibKey" type="password" class="form-control form-control-sm" autocomplete="new-password" placeholder="leave blank to keep current" /></div>
                                    <div class="col-md-6"><label class="form-label small">Default Sender ID</label>
                                        <input id="ibSender" class="form-control form-control-sm" /></div>
                                    <div class="col-12 d-flex gap-2">
                                        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save"></i> Save</button>
                                        <button type="button" id="btnIbClear" class="btn btn-outline-danger btn-sm">Remove override</button>
                                        <span id="ibStatus" class="ms-auto small text-muted"></span>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SHORTLINKS ============ -->
    <div class="tab-pane fade" id="tab-shortlinks">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">Shortlinks</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Slug</th><th>Clicks</th><th>Expires</th><th>Disabled</th><th></th></tr></thead>
                            <tbody id="slBody"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">Create shortlink</div>
                    <div class="card-body">
                        <form id="formSlCreate">
                            <div class="mb-2"><label class="form-label small">Target URL</label>
                                <input id="slUrl" type="url" class="form-control" required
                                       placeholder="https://example.com/landing" /></div>
                            <div class="mb-2"><label class="form-label small">Lifetime (days, optional)</label>
                                <input id="slDays" type="number" min="1" max="365" class="form-control" /></div>
                            <div class="mb-2"><label class="form-label small">Max clicks (optional)</label>
                                <input id="slMax" type="number" min="1" class="form-control" /></div>
                            <button type="submit" class="btn btn-primary btn-sm">Create</button>
                        </form>
                        <div id="slCreated" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ REPORTS ============ -->
    <div class="tab-pane fade" id="tab-reports">
        <div class="row g-2 mb-3">
            <div class="col-auto"><input type="date" id="rptFrom" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" id="rptTo" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <select id="rptKind" class="form-select form-select-sm">
                    <option value="sms-campaign">SMS Campaign</option>
                    <option value="delivery-funnel">Delivery Funnel</option>
                    <option value="shortlinks">Shortlinks</option>
                    <option value="reminder-effectiveness">Reminders</option>
                    <option value="ingestion-quality">Ingestion Quality</option>
                    <option value="audit-trail">Audit Trail</option>
                </select>
            </div>
            <div class="col-auto">
                <button id="btnRpt" class="btn btn-primary btn-sm">Run</button>
                <a id="btnCsv" class="btn btn-outline-secondary btn-sm">CSV</a>
            </div>
        </div>
        <div id="rptOut" class="card"><div class="card-body text-muted small">
            Pick a date range + report and click Run.
        </div></div>
    </div>

    <!-- ============ AUDIT ============ -->
    <div class="tab-pane fade" id="tab-audit">
        <div class="mb-2">
            <div class="btn-group btn-group-sm" id="audRangeGroup" role="group">
                <button type="button" class="btn btn-outline-secondary" data-range="today">Today</button>
                <button type="button" class="btn btn-outline-secondary" data-range="yesterday">Yesterday</button>
                <button type="button" class="btn btn-outline-secondary active" data-range="last7">Last 7 days</button>
                <button type="button" class="btn btn-outline-secondary" data-range="last30">Last 30 days</button>
                <button type="button" class="btn btn-outline-secondary" data-range="mtd">MTD</button>
            </div>
        </div>
        <div class="row g-2 mb-3 align-items-center">
            <div class="col-auto"><input type="date" id="audFrom" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" id="audTo" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <input id="audFilter" type="search" class="form-control form-control-sm"
                       placeholder="Filter rows (action, user, IP…)"
                       data-filter-target="#audBody" style="width:240px" />
            </div>
            <div class="col-auto">
                <button id="btnAud" class="btn btn-primary btn-sm">Load</button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm" data-sortable>
                <thead><tr>
                    <th data-sort="date">When</th>
                    <th data-sort="str">User</th>
                    <th data-sort="str">Action</th>
                    <th data-sort="str">Entity</th>
                    <th data-sort="str">IP</th>
                </tr></thead>
                <tbody id="audBody"><tr><td colspan="5" class="text-muted">Pick a range and click Load.</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<input type="hidden" id="projectId" value="@Model.ProjectId" />

<!-- ============ DRILL-DOWN MODALS ============ -->
<div class="modal fade" id="smsDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">SMS detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><pre id="smsDetailBody" class="small">Loading…</pre></div>
        </div>
    </div>
</div>

<div class="modal fade" id="slClicksModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Click history</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <table class="table table-sm">
                    <thead><tr><th>When</th><th>Device</th><th>Country</th><th>User-Agent</th></tr></thead>
                    <tbody id="slClicksBody"><tr><td colspan="4" class="text-muted">Loading…</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Per-batch rejection sample. Surfaces the WHY behind the "X rejected" count
     on the Sources tab batches list without making the operator dig through logs. -->
<div class="modal fade" id="rejectionsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-x-octagon"></i> Rejected rows</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="rejectionsBody">Loading…</div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/project-detail.js" asp-append-version="true"></script>
}
