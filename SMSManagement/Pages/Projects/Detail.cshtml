@page "{handler?}"
@model SMSManagement.Pages.Projects.DetailModel
@inject SMSManagement.Modules.Core.Localization.Localizer Loc
@{ ViewData["Title"] = "Project"; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Projects/Index">Projects</a></li>
        <li class="breadcrumb-item active" id="bcName">…</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-baseline mb-3">
    <h1 class="h3 mb-0" id="projName">Loading…</h1>
    <span class="text-muted" id="projCode"></span>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-settings">@Loc.Get("tab.settings")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-pipeline">Pipeline</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-members">@Loc.Get("tab.members")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-mappings">@Loc.Get("tab.mappings")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-sources">@Loc.Get("tab.sources")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-workflows">@Loc.Get("tab.workflows")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-sms">@Loc.Get("tab.sms")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-shortlinks">@Loc.Get("tab.shortlinks")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-coupons">Coupons</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-reports">@Loc.Get("tab.reports")</a></li>
    <li class="nav-item"><a class="nav-link"        data-bs-toggle="tab" href="#tab-audit">@Loc.Get("tab.audit")</a></li>
</ul>

<!-- Setup checklist — only shown when something the project needs is missing.
     JS hides this card entirely if every step is green. -->
<div id="onboardingChecklist" class="card border-warning mb-3" style="display:none">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-check"></i> Setup checklist</span>
        <button type="button" class="btn-close" aria-label="Dismiss"
                onclick="document.getElementById('onboardingChecklist').style.display='none'"></button>
    </div>
    <div class="card-body py-2">
        <ul class="list-unstyled small mb-0" id="onboardingList"></ul>
    </div>
</div>

<div class="tab-content">
    <!-- ============ SETTINGS ============ -->
    <div class="tab-pane fade show active" id="tab-settings">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Project info</div>
                    <div class="card-body">
                        <form id="formInfo">
                            <div class="mb-2">
                                <label class="form-label small">Name</label>
                                <input id="setName" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Default SMS provider</label>
                                <select id="setProvider" class="form-select">
                                    <option value="etracker">MacroKiosk</option>
                                    <option value="infobip">Infobip</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Features enabled</div>
                    <div class="card-body">
                        <form id="formFeatures">
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featSms"><label class="form-check-label" for="featSms">SMS dispatch</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featShortlink"><label class="form-check-label" for="featShortlink">Shortlinks</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featWorkflow"><label class="form-check-label" for="featWorkflow">Workflow engine</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featIngestion"><label class="form-check-label" for="featIngestion">Ingestion (upload/SFTP)</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featEmail"><label class="form-check-label" for="featEmail">Email alerts</label></div>
                            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="featCouponCheck"><label class="form-check-label" for="featCouponCheck">ตรวจคูปองให้พอก่อนส่ง (บล็อกทั้งรอบถ้าไม่พอ)</label></div>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Shortlink generation</div>
                    <div class="card-body">
                        <form id="formShortlink">
                            <div class="mb-2">
                                <label class="form-label small">Shortlink domain (base URL)</label>
                                <input id="slBaseUrl" class="form-control" type="url"
                                       placeholder="https://sms.ipsossurvey.com/s" />
                                <div class="form-text">
                                    โดเมนที่ใช้เขียนลิงก์ย่อในข้อความของโปรเจ็คนี้ — ลิงก์จะเป็น
                                    <code>{โดเมนนี้}/{slug}</code>. เว้นว่าง = ใช้ค่ากลางของระบบ.
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Slug length (4-16)</label>
                                <input id="slLength" type="number" min="4" max="16" class="form-control" />
                                <div class="form-text">Blank = use platform default (8).</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">
                                    Custom alphabet
                                    <i class="bi bi-info-circle text-muted" tabindex="0"
                                       data-bs-toggle="popover" data-bs-trigger="hover focus"
                                       data-bs-placement="right" data-bs-html="true"
                                       title="Custom alphabet"
                                       data-bs-content="Characters that slug generation may pick from. Each character used 0+ times; uniqueness is enforced.<br><br>
<strong>Examples:</strong><br>
<code>ABCDEFGHIJKLMNPQRSTUVWXYZ23456789</code> &mdash; uppercase + digits, no <code>O/0/I/1/L</code> (easy to type by phone)<br>
<code>0123456789</code> &mdash; numeric-only (great for SMS, but short = collision risk &mdash; pair with longer slug length)<br>
<code>abcdefghijkmnpqrstuvwxyz</code> &mdash; lowercase, ambiguous chars stripped<br>
<code>ABCDEFGHJKMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789</code> &mdash; balanced default-style<br><br>
Rules: 10–80 characters, must be unique, only <code>A-Z a-z 0-9 _ -</code>. Case-sensitive. Blank = platform default (57-char URL-safe).">
                                    </i>
                                </label>
                                <input id="slAlpha" class="form-control" maxlength="80"
                                       pattern="[A-Za-z0-9_\-]+"
                                       placeholder="A-Z a-z 0-9 _ - (10–80 unique chars; case-sensitive)" />
                                <div class="form-text">Blank = default 57-char URL-safe alphabet.</div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">Email notifications</div>
                    <div class="card-body">
                        <form id="formNotif">
                            <div class="mb-2">
                                <label class="form-label small">Recipients (comma-separated)</label>
                                <input id="notifEmails" class="form-control" placeholder="ops@x.com, mgr@x.com" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Subject prefix</label>
                                <input id="notifPrefix" class="form-control" placeholder="[Project name]" />
                            </div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifSuccess"><label class="form-check-label" for="notifSuccess">Notify on ingest success</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifPartial"><label class="form-check-label" for="notifPartial">Notify on partial</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifFailure"><label class="form-check-label" for="notifFailure">Notify on failure</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="notifSmsRound"><label class="form-check-label" for="notifSmsRound">Notify on SMS round complete (summary + CSV log attached)</label></div>
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Save</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-12" id="dangerZone" style="display:none">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">Danger zone</div>
                    <div class="card-body">
                        <div class="d-flex gap-3 align-items-center mb-2">
                            <button id="btnArchive" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-archive"></i> Archive project
                            </button>
                            <span class="text-muted small">
                                Hides the project + cancels in-flight workflows and queued SMS.
                                Reversible by an admin.
                            </span>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <input id="xferUser" class="form-control form-control-sm"
                                   style="max-width:280px" placeholder="New owner — search by email" />
                            <input id="xferUserId" type="hidden" />
                            <button id="btnTransfer" class="btn btn-outline-warning btn-sm" disabled>
                                <i class="bi bi-arrow-left-right"></i> Transfer ownership
                            </button>
                            <span class="text-muted small">You stop being Owner after this.</span>
                        </div>
                        <div id="xferResults" class="mt-1"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ ARCHIVE CONFIRMATION MODAL ============ -->
    <!-- Math challenge: forces a deliberate keystroke pattern that no double-
         click or hammer-on-Enter can satisfy. Sum is regenerated each open. -->
    <div class="modal fade" id="archiveModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content border-danger">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle"></i> Archive project
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will hide the project and cancel in-flight workflows + queued SMS.</p>
                    <p class="small text-muted">An admin can restore the project later from
                        <strong>Admin → All projects</strong> (toggle "Include archived").</p>
                    <hr>
                    <p class="mb-2"><strong>To confirm, solve:</strong></p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold font-monospace fs-5" id="archMath"></span>
                        <span>=</span>
                        <input id="archAnswer" type="number" class="form-control form-control-sm"
                               style="width:90px" autocomplete="off" />
                        <span id="archHint" class="small text-danger ms-2"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="btnArchiveGo" class="btn btn-danger" disabled>
                        <i class="bi bi-archive"></i> Archive
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ PIPELINE ============ -->
    <!-- End-to-end campaign overview: every stage from file source to the
         result email, each with a status light and a jump to its editor. -->
    <div class="tab-pane fade" id="tab-pipeline">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Campaign pipeline — ภาพรวมการทำงานทั้งหมด</span>
                <button id="btnPipelineRefresh" class="btn btn-sm btn-link p-0">รีเฟรช</button>
            </div>
            <div class="card-body">
                <p class="small text-muted">
                    ขั้นตอนการทำงานของแคมเปญ เรียงตามลำดับจริง — เขียว = ตั้งค่าครบ,
                    เหลือง = ยังต้องตั้งค่า, เทา = ปิด/ไม่บังคับ. คลิก "ตั้งค่า" เพื่อไปแก้แต่ละขั้น
                </p>
                <div id="pipelineStages"
                     style="display:flex;flex-wrap:wrap;align-items:stretch;gap:.25rem"></div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                ประวัติการรัน (Runs) — flow นี้ทำงานไปกี่รอบ แต่ละรอบแต่ละขั้นเป็นอย่างไร
            </div>
            <div class="card-body">
                <div id="pipelineRuns"></div>
            </div>
        </div>
    </div>

    <!-- ============ MEMBERS ============ -->
    <div class="tab-pane fade" id="tab-members">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">Members</div>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>User</th><th>Email</th><th>Level</th><th>Granted</th><th></th></tr>
                            </thead>
                            <tbody id="membersBody"><tr><td colspan="5" class="text-muted">Loading…</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">Share project</div>
                    <div class="card-body">
                        <form id="formShare" autocomplete="off">
                            <div class="mb-2 position-relative">
                                <label class="form-label small">Find user (email / name)</label>
                                <input id="shareQuery" class="form-control" required
                                       placeholder="Type 2+ characters…" />
                                <input id="shareUserId" type="hidden" />
                                <div id="shareResults" class="list-group position-absolute w-100"
                                     style="z-index:10; max-height:200px; overflow:auto"></div>
                                <div id="sharePicked" class="form-text text-success"></div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Level</label>
                                <select id="shareLevel" class="form-select">
                                    <option value="Viewer">Viewer (read-only)</option>
                                    <option value="Member">Member (use features)</option>
                                    <option value="Admin">Admin (configure + share)</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm" id="btnShare" disabled>
                                <i class="bi bi-person-plus"></i> Share
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ MAPPINGS ============ -->
    <div class="tab-pane fade" id="tab-mappings">
        <!-- Pipeline scope: cleansing + validation can be configured per
             ingestion source (each source = its own pipeline), or shared. -->
        <div class="card mb-3">
            <div class="card-body py-2 d-flex align-items-center gap-2 flex-wrap">
                <label class="form-label small mb-0">ตั้งค่าให้ pipeline:</label>
                <select id="mapScope" class="form-select form-select-sm" style="max-width:320px">
                    <option value="">📋 ใช้ร่วมทุก source (shared)</option>
                </select>
                <span class="small text-muted">
                    เลือก source เพื่อตั้งค่าทำความสะอาด/ตรวจสอบเฉพาะของ source นั้น —
                    source ที่ไม่มีของตัวเองจะใช้ชุด "shared"
                </span>
            </div>
        </div>

        <!-- Easy setup: a non-technical operator uploads a sample, picks a
             plain-language field type per column, previews before/after, and
             saves. Expands into transforms + rules behind the scenes. -->
        <div class="card mb-3 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-magic"></i> ตั้งค่าไฟล์แบบง่าย — Easy setup</span>
                <small>สำหรับคนไม่ใช่ IT</small>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-2">
                    อัปโหลดไฟล์ตัวอย่าง แล้วเลือกว่าแต่ละคอลัมน์คืออะไร —
                    ระบบจะจัดรูปแบบและตรวจสอบข้อมูลให้เอง ไม่ต้องรู้เรื่องโค้ด
                </p>
                <input id="easyFile" type="file" accept=".csv,.xlsx,.xls"
                       class="form-control form-control-sm mb-3" style="max-width:380px" />
                <div id="easyCols" class="d-none">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead><tr>
                                <th style="width:150px">คอลัมน์ในไฟล์</th>
                                <th style="width:140px">ตัวอย่างข้อมูล</th>
                                <th style="width:180px">คอลัมน์นี้คืออะไร</th>
                                <th>ตัวเลือก</th>
                            </tr></thead>
                            <tbody id="easyColsBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" id="btnEasyPreview" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-eye"></i> ดูตัวอย่างผล (ก่อน/หลัง)
                        </button>
                        <button type="button" id="btnEasySave" class="btn btn-primary btn-sm">
                            <i class="bi bi-save"></i> บันทึกการตั้งค่า
                        </button>
                        <span id="easyStatus" class="small ms-2"></span>
                    </div>
                    <div id="easyPreview" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- Drag-and-drop a sample file to auto-detect headers. The file is
             parsed in memory and never persisted; only column names + a 5-row
             sample come back. Saves operators from typing headers by hand. -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Detect from sample file</span>
                <small class="text-muted">CSV / XLSX / XLS, ≤10 MB</small>
            </div>
            <div class="card-body">
                <div id="mapDrop" class="border border-2 border-dashed rounded p-4 text-center text-muted"
                     style="cursor:pointer">
                    <i class="bi bi-cloud-arrow-up fs-3"></i>
                    <div class="small">Drop a sample file here, or
                        <a href="#" id="mapPickFile">browse</a>
                    </div>
                    <input id="mapFile" type="file" accept=".csv,.xlsx,.xls" hidden />
                </div>
                <div id="mapPreview" class="mt-3 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small">
                            <i class="bi bi-file-earmark-check text-success"></i>
                            <code id="mapFileName"></code>
                            <span class="text-muted ms-2">— pick a field for each column you care about, then save them all.</span>
                        </span>
                        <button id="btnMapApplyAll" class="btn btn-success btn-sm" disabled>
                            <i class="bi bi-check2-all"></i> Save selected
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Source column</th><th>Sample values</th>
                                    <th style="width:130px">Canonical field</th>
                                    <th style="width:200px">Transforms</th></tr>
                            </thead>
                            <tbody id="mapPreviewBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cheat-sheet for canonical fields. Operators hit this once and remember it;
             the labels in the dropdown match the {{placeholders}} they'd use in SMS bodies. -->
        <div class="alert alert-info small mb-3">
            <i class="bi bi-info-circle"></i>
            <strong>Failure semantics:</strong> when ingestion runs, each row is mapped + validated independently.
            Rows that fail go to the rejected folder; the rest of the file still completes.
            Click a batch in the <a href="#" onclick="gotoTab('#tab-sources');return false;">Sources</a> tab to see rejection details.
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-key"></i> Canonical fields cheat-sheet
            </div>
            <div class="card-body p-2">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light"><tr>
                            <th>Field</th><th>Placeholder</th><th>Used by</th><th>Notes</th>
                        </tr></thead>
                        <tbody>
                            <tr>
                                <td><code>phone</code> <span class="badge bg-danger">required</span></td>
                                <td><code>{{phone}}</code></td>
                                <td>SMS dispatcher (recipient)</td>
                                <td>8–15 digits. Combine country-code + number with <em>Join order</em> or use the <code>prefix_66</code> transform.</td>
                            </tr>
                            <tr>
                                <td><code>name</code></td>
                                <td><code>{{name}}</code></td>
                                <td>SMS template body, greeting</td>
                                <td>Combine <code>first_name</code> + <code>last_name</code> by mapping both to <code>name</code> with different Join orders.</td>
                            </tr>
                            <tr>
                                <td><code>url</code></td>
                                <td><code>{{url}}</code></td>
                                <td>Shortlink module (when enabled)</td>
                                <td>
                                    Replaced with <code>https://&lt;your-host&gt;/&lt;slug&gt;</code> at send time
                                    only when <strong>Shortlink</strong> feature is ON in
                                    <a href="#" onclick="gotoTab('#tab-settings');return false;">Settings</a>.
                                    When off, the original URL is sent as-is. Click events fire <code>shortlink.clicked</code> back to the workflow.
                                </td>
                            </tr>
                            <tr>
                                <td><code>message</code></td>
                                <td><code>{{message}}</code></td>
                                <td>SMS body when a per-row override is needed</td>
                                <td>Lets a CSV column carry the full body instead of using the workflow template. Optional.</td>
                            </tr>
                            <tr>
                                <td><code>email</code></td>
                                <td><code>{{email}}</code></td>
                                <td>Email notifications (success / failure)</td>
                                <td>Used by the per-project notification recipients list, not the SMS dispatcher.</td>
                            </tr>
                            <tr>
                                <td><code>custom</code></td>
                                <td><code>{{custom}}</code></td>
                                <td>Anywhere a free-form column is needed</td>
                                <td>Catch-all for one extra field. For multiple extras, request the canonical list be expanded.</td>
                            </tr>
                            <tr class="table-light">
                                <td colspan="4" class="small text-muted">
                                    <strong>Workflow-injected placeholders</strong> (not from the row):
                                    <code>{{attempt}}</code> 1-based round counter on the current step ·
