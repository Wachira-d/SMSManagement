@page
@model SMSManagement.Pages.Projects.IndexModel
@{ ViewData["Title"] = "Projects"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Projects</h1>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-page="/Projects/Create">
            <i class="bi bi-plus-lg"></i> New project
        </a>
    }
</div>

<div id="projectList" class="row g-3"></div>
<div id="empty" class="text-center text-muted py-5" style="display:none">
    <i class="bi bi-folder2-open" style="font-size:3rem"></i>
    <p class="mt-3">No projects yet. @(Model.CanCreate ? "Click \"New project\" to create one." : "Ask a project admin to share one with you.")</p>
</div>

@section Scripts {
<script>
(async function () {
    try {
        // Two queries in parallel — stats endpoint pre-aggregates so a
        // dashboard with 50 projects still renders in one round-trip pair.
        const [rows, stats] = await Promise.all([
            api.get('/api/projects'),
            api.get('/api/projects/dashboard-stats').catch(() => [])
        ]);
        const list = document.getElementById('projectList');
        if (!rows.length) {
            document.getElementById('empty').style.display = '';
            return;
        }
        const statMap = new Map(stats.map(s => [s.projectId, s]));
        list.innerHTML = rows.map(p => {
            const s = statMap.get(p.id) || { smsLast24h: 0, activeInstances: 0, failedBatchesWeek: 0 };
            // Health pill — red if anything failed in the last week, amber if
            // there's nothing happening, green if instances are alive.
            const health = s.failedBatchesWeek > 0
                ? '<span class="badge bg-danger" title="Failed batches this week">⚠ ' + s.failedBatchesWeek + ' failed</span>'
                : s.activeInstances > 0
                    ? '<span class="badge bg-success">Active</span>'
                    : '<span class="badge bg-secondary">Idle</span>';
            return `<div class="col-md-6 col-lg-4">
                <a href="/Projects/Detail?id=${esc(p.id)}" class="text-decoration-none">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-1">${esc(p.name)}</h5>
                                ${health}
                            </div>
                            <p class="card-text text-muted small mb-2">
                                <code>${esc(p.code)}</code>
                                · Provider: ${esc(p.defaultProvider)}
                            </p>
                            <div class="row g-1 text-center small">
                                <div class="col-4">
                                    <div class="fw-bold">${s.smsLast24h.toLocaleString()}</div>
                                    <div class="text-muted">SMS / 24h</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold">${s.activeInstances.toLocaleString()}</div>
                                    <div class="text-muted">active workflows</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold ${s.failedBatchesWeek > 0 ? 'text-danger' : ''}">${s.failedBatchesWeek}</div>
                                    <div class="text-muted">failed batches</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <span class="badge bg-secondary">${esc(p.myAccess ?? 'None')}</span>
                            <span class="text-muted small float-end">
                                Created ${fmtDate(p.createdAt)}
                            </span>
                        </div>
                    </div>
                </a>
            </div>`;
        }).join('');
    } catch (e) {
        toast('Failed to load projects: ' + e.message, 'danger');
    }
})();
</script>
}
